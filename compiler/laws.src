# Laws & transformations -- BLOCK grammar, one action per line.
#   law <name>
#       when <cond>            (repeatable ; all required)
#       react | danger         (verdict)
#       set <dim> = <val> | scale <axis>|eff|qty x<f> | add <label> | remove <label> | give | cap <n>
#   cond : <axis> = <val> | <axis> >= <n> | <axis> <= <n> | <axis> is <band> | <axis> (presence)
# Law order sets the tie-break on equal elaboration (seq) -- do not reorder without reason.
#   describe "text"          optional player-facing description (JSON quoted string)
#   observe                  observation only: describe required, no transformation actions
# Observation conditions may overlap; they do not compete with crafting laws.


@cutting_board
law harvest
    when  meta.stage is plant
    when  meta.taxonomy is cuttable
    react
    give

# multi-organ harvest (yield = accumulates; every matching law fires together).
# NOTE: overlaps the bare 'harvest' above — keep one model once the runtime
# evaluator handles 'yield'. The runtime only hands organs the species actually has.
law harvest_leaf
    when  meta.stage is plant
    when  meta.taxonomy is cuttable
    yield
    give  leaf

law harvest_root
    when  meta.stage is plant
    when  meta.taxonomy is cuttable
    yield
    give  root

law chop
    when  meta.taxonomy is leaf_plant
    when  meta.stage is leaf
    react
    set   meta.stage = chopped
    scale qty x5
    describe "The leaves are chopped."

law choptatoes
    when meta.taxonomy is potato
    when meta.stage is harvested
    react
    set meta.stage = sliced

law mince
    when  meta.taxonomy is leaf_plant
    when  meta.stage is chopped
    react
    set   meta.stage = minced      # refine only (no x qty) ; minced = terminal on the board

# The current material stage supplies the starting point. Active cutting time
# supplies fab.grind (fineness) directly, without changing stock.
law observe_plant
    when meta.stage is plant
    observe
    describe "The plant is whole."

law observe_leaf
    when meta.stage is leaf
    when fab.grind is light
    observe
    describe "The leaves are whole."

law observe_leaf_coarse
    when meta.stage is leaf
    when fab.grind is coarse
    observe
    describe "The leaves are roughly chopped."

law observe_leaf_fine
    when meta.stage is leaf
    when fab.grind is fine
    observe
    describe "The leaves are chopped."

law observe_leaf_extra
    when meta.stage is leaf
    when fab.grind is extra
    observe
    describe "The leaves are finely chopped."

law observe_leaf_minced
    when meta.stage is leaf
    when fab.grind is over
    observe
    describe "The leaves are finely minced."

law observe_chopped
    when meta.stage is chopped
    when fab.grind <= 6
    observe
    describe "The leaves are chopped."

law observe_chopped_extra
    when meta.stage is chopped
    when fab.grind is extra
    observe
    describe "The leaves are finely chopped."

law observe_chopped_minced
    when meta.stage is chopped
    when fab.grind is over
    observe
    describe "The leaves are finely minced."

law observe_minced
    when meta.stage is minced
    observe
    describe "The leaves are finely minced."

law observe_harvested
    when meta.stage is harvested
    observe
    describe "The material has been harvested."

law observe_sliced
    when meta.stage is sliced
    observe
    describe "The material is cut into slices."

law observe_twig
    when meta.stage is twig
    observe
    describe "The preparation contains twigs."

law observe_powder
    when meta.stage is powder
    observe
    describe "The material is in powder form."

law observe_essence
    when meta.stage is essence
    observe
    describe "The material is an essence."

law observe_pills
    when meta.stage is pils
    observe
    describe "The material is in pill form."

law observe_poultice
    when meta.stage is poultice
    observe
    describe "The material is a poultice."

law observe_seed
    when meta.stage is seed
    observe
    describe "The preparation contains seeds."

law observe_sprout
    when meta.stage is sprout
    observe
    describe "The preparation contains young sprouts."

law observe_mature
    when meta.stage is mature
    observe
    describe "The plant is fully grown."

law observe_withered
    when meta.stage is withered
    observe
    describe "The plant is withered."

law observe_fried
    when meta.stage is fried
    observe
    describe "The material is fried."

law observe_brine
    when meta.stage is brine
    observe
    describe "The preparation is brine."

law observe_saline_iv
    when meta.stage is saline_iv
    observe
    describe "The preparation is an IV saline solution."

# Smell complements the material description; it does not imply freshness or safety.
law observe_fragrant
    when org.smell is fragrant
    observe
    describe "It has a fragrant smell."

law observe_putrid
    when org.smell is putrid
    observe
    describe "It gives off a putrid smell."

@mortar
# organ eligibility: only a grindable organ (fresh, pre-transformation) can be
# ground here. 'meta.organ is grindable' matches the organ's tag token.
law grind_organ
    when  meta.organ is grindable
    react
    set   meta.stage = powder
    scale qty x0.6

law grind
    when  meta.taxonomy is leaf_plant
    when  meta.stage is leaf
    react
    set   meta.stage = powder
    scale act.nervous x2
    scale qty x0.6

law over
    when  meta.taxonomy is leaf_plant
    when  meta.stage is leaf
    when  fab.grind is over
    react
    set   meta.stage = powder
    scale act.nervous x2
    scale eff x0.5
    scale qty x0.5

law grind_fine
    when  meta.taxonomy is leaf_plant
    when  meta.stage is chopped
    react
    set   meta.stage = powder
    scale act.nervous x2.5      # better concentrated than the whole leaf (x2)
    scale qty x0.9              # less loss than starting from the leaf (x0.6)

law over_fine
    when  meta.taxonomy is leaf_plant
    when  meta.stage is chopped
    when  fab.grind is over
    react
    set   meta.stage = powder
    scale act.nervous x2.5
    scale eff x0.5
    scale qty x0.5

law grind_ultra
    when  meta.taxonomy is leaf_plant
    when  meta.stage is minced
    react
    set   meta.stage = powder
    scale act.nervous x3           # the finest = the best extracted

law over_ultra
    when  meta.taxonomy is leaf_plant
    when  meta.stage is minced
    when  fab.grind is over
    react
    set   meta.stage = powder
    scale act.nervous x3
    scale eff x0.5
    scale qty x0.5

law poultice
    when  meta.taxonomy is leaf_plant
    when  meta.stage is powder           
    when  meta.taxonomy is liquid       # a liquid is required in the basket
    react
    set   meta.stage = poultice
    scale act.fluidifying x1.5         # the liquid "binds" the paste, e.g.


@alambic
law distill_water                # potable water -> sterile (medical purification; the "knowledge" lever)
    when meta.taxonomy is water
    when org.purity is potable
    react
    scale org.purity x3          # 3 -> 9 (sterile, clamped to 10) ; unlocks 'perf' (IV saline)


@cauldron
law overcooked
    when  fab.thermal is boiling
    react
    scale eff x0.5

law cooked_ok
    when  fab.thermal is simmer
    react
    keep

law corrosif
    when  fab.acidity is acidic
    when  fab.stability is explosive
    danger
    add   act.toxic
    cap   10

law vomitif
    when  org.bitter is bitter
    react
    add   act.vomiting

law boil_water                   # raw water -> potable (tea-grade). 'is foul' => acts once, no re-boil stacking.
    when fab.thermal is boiling
    when meta.taxonomy is water
    when org.purity is foul
    react
    scale org.purity x3          # 1 -> 3 (potable) ; enough for tea / brine, NOT for medical use


law perf                         # sterile water + ~isotonic salt -> IV saline (medical grade)
    when meta.taxonomy is water
    when org.purity >= 7         # sterile only (reached by distillation, not mere boiling)
    when org.salty <= 2          # pincee -> isotonique
    react
    set meta.stage = saline_iv

law brine                        # potable water + lots of salt -> brine (sterility not required)
    when meta.taxonomy is water
    when org.purity >= 3
    when org.salty >= 3          # beaucoup -> saumure
    react
    set meta.stage = brine

law fry
    when fab.thermal is frying        # > ~160C, hors d'atteinte pour l'eau
    when org.viscosity is thick
    react
    add act.todo

law makefries 
    when meta.taxonomy is potato
    when fab.thermal is frying
    when org.viscosity is thick
    when meta.stage is sliced 
    react
    set meta.stage = fried
    scale eff x1.5


# Read-only observations for the future P4 consultation. No product is created.
law observe_simmer
    when fab.thermal is simmer
    observe
    describe "The mixture is gently simmering."

law observe_boiling
    when fab.thermal is boiling
    observe
    describe "The mixture is boiling."

law observe_thick
    when org.viscosity is thick
    observe
    describe "The mixture is thick."

law observe_putrid
    when org.smell is putrid
    observe
    describe "It gives off a putrid smell."


@field
law sprout
    when meta.stage is seed
    when meta.elapsed_time >= 60       # 1h depuis la plantation
    react
    set  meta.stage = sprout

law mature
    when meta.stage is sprout
    when meta.elapsed_time >= 240      # 4h
    react
    set  meta.stage = mature

law harvest
    when meta.stage is mature
    react
    give

